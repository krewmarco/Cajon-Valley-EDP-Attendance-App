# Copy to scanner/.env (git-ignored) and replace both values, e.g. with: openssl rand -hex 24

# Shared secret between the dongle manager and each dongle (X-Scanner-Auth)
SCANNER_AUTH_TOKEN=change-me-dongle-token

# Secret the attendance app must send to the dongle manager (X-Manager-Auth)
MANAGER_CLIENT_TOKEN=change-me-client-token

# Comma-separated browser origins allowed to call the manager (app dev server is :3000)
ALLOWED_ORIGINS=http://localhost:3000
