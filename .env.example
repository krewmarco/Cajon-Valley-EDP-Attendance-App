## ── Core (Required) ────────────────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

## ── AI Generation (Optional) ────────────────────────────────────────────────
## Gemini API key for AI-assisted parent report generation in the Leader Dashboard.
## Get yours at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

## ── Google Drive Audit Backend (Optional — see docs/GOOGLE_DRIVE_SETUP.md) ──
## Web App URL from the deployed EDP_StudentSync Google Apps Script.
## When set, every student event is written to a Google Drive folder in real time.
## Leave blank to disable Drive sync (app works normally without it).
VITE_GAS_WEBHOOK_URL=

## Audit destinations (comma-separated): local, google-docs.
## Unset = `local` in dev mode, plus `google-docs` when VITE_GAS_WEBHOOK_URL is set.
## For a dev Google Doc trail, point VITE_GAS_WEBHOOK_URL at a separate DEV deployment.
VITE_AUDIT_PROVIDERS=

## Shared secret token for GAS request authentication (optional hardening).
## Must match AUTH_TOKEN in the EDP_StudentSync.gs CONFIG block.
VITE_GAS_AUTH_TOKEN=

## Root Google Drive folder ID (set inside GAS script CONFIG — this is informational).
## Find it in the Drive folder URL: drive.google.com/drive/folders/FOLDER_ID_HERE
VITE_GDRIVE_ROOT_FOLDER_ID=

## ── ELOP API (Future — implement stub in src/services/googleDriveService.ts) ─
## District ELOP check-in/out API. Wire in when Cajon Valley USD provides credentials.
VITE_ELOP_API_BASE_URL=
VITE_ELOP_API_KEY=

## ── ASES API (Future — implement stub in src/services/googleDriveService.ts) ─
## District ASES attendance sync API.
VITE_ASES_API_BASE_URL=
VITE_ASES_API_KEY=

## ── Yearbook Photo API (Future — implement stub in src/services/googleDriveService.ts)
## District student photo system — used to sync official yearbook photos to student records.
VITE_YEARBOOK_PHOTO_API_URL=
VITE_YEARBOOK_API_KEY=

## ── USB Scanner Dongle (Optional — see scanner/README.md) ───────────────────
## Dongle manager relay that types the student's ID into the SIS portal on
## check-in. Each device is normally configured from the "Scanner" pill in the
## app header (stored per device); these are defaults for local development.
## Leave the token blank in production builds — VITE_* values ship in the bundle.
VITE_SCANNER_MANAGER_URL=
VITE_SCANNER_MANAGER_TOKEN=
VITE_SCANNER_STATION_ID=
